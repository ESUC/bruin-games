# Copy this file to .env and fill in the values.
#   cp .env.example .env
# .env is git-ignored. NEVER commit real keys. This example file IS committed, so keep it blank.

# --- Supabase (Dashboard → Project Settings → API) ---
# NEXT_PUBLIC_ means "safe to send to the browser". The anon/publishable key is designed for that;
# Row Level Security (supabase/migrations/0001_init.sql) is what actually protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security, so it must NEVER start with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis (console.upstash.com → your database → REST API) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App ---
# Where the site runs. Used for auth redirects. On Vercel, set this to your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
